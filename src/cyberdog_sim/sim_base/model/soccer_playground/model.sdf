      <visual name="circle_06"><pose>-0.624 0.417 0.007 0 0 4.123</pose><geometry><box><size>0.293 0.04 0.014</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="circle_07"><pose>-0.736 0.146 0.007 0 0 4.516</pose><geometry><box><size>0.293 0.04 0.014</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="circle_08"><pose>-0.736 -0.146 0.007 0 0 4.909</pose><geometry><box><size>0.293 0.04 0.014</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="circle_09"><pose>-0.624 -0.417 0.007 0 0 5.301</pose><geometry><box><size>0.293 0.04 0.014</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
