      <visual name="circle_11"><pose>-0.146 -0.736 0.007 0 0 6.087</pose><geometry><box><size>0.293 0.04 0.014</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="circle_12"><pose>0.146 -0.736 0.007 0 0 0.196</pose><geometry><box><size>0.293 0.04 0.014</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="circle_13"><pose>0.417 -0.624 0.007 0 0 0.589</pose><geometry><box><size>0.293 0.04 0.014</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="circle_14"><pose>0.624 -0.417 0.007 0 0 0.982</pose><geometry><box><size>0.293 0.04 0.014</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="circle_15"><pose>0.736 -0.146 0.007 0 0 1.374</pose><geometry><box><size>0.293 0.04 0.014</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
