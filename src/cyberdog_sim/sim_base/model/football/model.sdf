<?xml version="1.0"?>
<sdf version="1.7">
  <model name="football">
    <static>false</static>
    <link name="ball">
      <inertial>
        <!-- FIFA size-5 ball: 0.22 m diameter, 0.43 kg.  The diagonal
             inertia is 2/5*m*r^2 for a uniform spherical approximation. -->
        <mass>0.43</mass>
        <inertia>
          <ixx>0.0020812</ixx>
          <iyy>0.0020812</iyy>
          <izz>0.0020812</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="ball_collision">
        <geometry><sphere><radius>0.11</radius></sphere></geometry>
        <surface>
          <friction>
            <ode><mu>0.35</mu><mu2>0.35</mu2><slip1>0.002</slip1><slip2>0.002</slip2></ode>
            <!-- Torsional friction supplies rolling resistance on turf;
                 surface_radius lets ODE calculate a finite contact patch. -->
            <torsional>
              <coefficient>0.018</coefficient>
              <use_patch_radius>false</use_patch_radius>
              <surface_radius>0.11</surface_radius>
              <ode><slip>0.001</slip></ode>
            </torsional>
          </friction>
          <bounce>
            <restitution_coefficient>0.72</restitution_coefficient>
            <threshold>0.10</threshold>
          </bounce>
          <contact>
            <collide_without_contact>false</collide_without_contact>
            <ode><kp>1500000</kp><kd>80</kd><max_vel>0.8</max_vel><min_depth>0.0005</min_depth></ode>
          </contact>
        </surface>
      </collision>
      <visual name="ball_visual">
        <geometry><sphere><radius>0.11</radius></sphere></geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <!-- Small aerodynamic loss only.  Ground deceleration comes primarily
           from the contact/friction model above, so a kick transfers its
           actual rigid-body contact impulse instead of a scripted velocity. -->
      <velocity_decay><linear>0.01</linear><angular>0.0</angular></velocity_decay>
      <self_collide>false</self_collide>
    </link>
  </model>
</sdf>
